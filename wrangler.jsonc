{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dsh.righttu.uk",
      "custom_domain": true
    }
  ],
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_ctx_exports"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "AI_GATEWAY_ID": "dsh-cf",
    "AI_MODEL": "dynamic/dsh"
  },
  "ai": {
    "binding": "AI"
  },
  "containers": [
    {
      "class_name": "DshAgent",
      "scheduling_policy": "durable_object",
      "images": {
        "dsh": {
          "dockerfile": "./Dockerfile"
        },
        "v2": {
          "dockerfile": "./Dockerfile",
          "build_vars": {
            "DSH_APP_VERSION": "v2"
          }
        }
      }
    },
    {
      "class_name": "SnapshotLab",
      "scheduling_policy": "durable_object",
      "images": { "dsh": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DSH",
        "class_name": "DshAgent"
      },
      { "name": "SNAPSHOT_LAB", "class_name": "SnapshotLab" }
    ]
  },
  "exports": {
    "SnapshotLab": { "type": "durable-object", "storage": "sqlite" },
    "DshAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "dsh-cf-backups"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  }
}
